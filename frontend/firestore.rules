rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthed() { return request.auth != null; }
    function isUser(userId) { return isAuthed() && request.auth.uid == userId; }
    function hasRole(role) {
      return isAuthed() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    function isAdmin() { return hasRole("admin"); }
    function isDriver() { return hasRole("driver"); }
    function isRider() { return hasRole("rider"); }
    function isPartner() { return hasRole("partners"); }

    match /users/{userId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && isUser(userId);
      allow update: if isAuthed() && (isUser(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /rides/{rideId} {
      allow read: if isAuthed() && (
        resource.data.userId == request.auth.uid || 
        resource.data.driverId == request.auth.uid || 
        isAdmin() || 
        isPartner() ||
        (isDriver() && resource.data.status == "requested")
      );
      allow create: if isAuthed();
      allow update: if isAuthed() && (resource.data.userId == request.auth.uid || resource.data.driverId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if isAuthed() && (resource.data.userId == request.auth.uid || isDriver() || isAdmin());
      allow create: if isAuthed();
      allow update: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /fixedRides/{fixedId} {
      allow read: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isRider();
      allow update: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /rewards/{userId} {
      allow read: if isAuthed() && userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /partners/{partnerId} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin() || isPartner();
    }

    match /programs/{programId} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin() || isPartner();
    }

    match /notifications/{notifId} {
      allow read: if isAuthed() && resource.data.recipientId == request.auth.uid;
      allow create: if isAuthed();
      allow update: if isAuthed() && (resource.data.recipientId == request.auth.uid || isAdmin() || isDriver());
      allow delete: if isAdmin() || isDriver();
    }

    match /supportTickets/{ticketId} {
      allow read: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthed();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /emergencyAlerts/{alertId} {
      allow read: if isAdmin();
      allow create: if isAuthed();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isAuthed() && (resource.data.userId == request.auth.uid || isAdmin() || isPartner());
      allow write: if isAdmin();
    }
  }
}
